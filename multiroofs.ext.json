{
  "type": "CityJSONExtension",
  "name": "multiroofs",
  "uri": "https://multiroofs.be/myextension.json",
  "version": "0.2.0",
  "versionCityJSON": "2.0",
  "description": "Attributes needed for the MultiRoofs project",
  "extraAttributes": {
    "Building": {
      "+building-function": {
        "type": ["string", "null"],
        "enum": [
          "commercial",
          "industrial",
          "office",
          "public",
          "residential"
        ]
      },
      "+building-height": {
        "type": ["number", "null"]
      },
      "+building-has-elevator": {
        "type": ["boolean", "null"]
      },
      "+building-max-height-allowed": {
        "type": ["number", "null"]
      },
      "+building-energy-label": {
        "type": ["string", "null"]
      },
      "+building-monument": {
        "type": ["boolean", "null"]
      },
      "+building-ownership": {
        "type": ["string", "null"],
        "enum": [
          "corporate real estate owner", 
          "homeowner association", 
          "housing corporation", 
          "industrial property owner",
          "institutional investor",
          "landlord", 
          "municipal real estate owner", 
          "private individual homeowner", 
          "private project developers",
          "religious institution"
        ]
      },
      "+building-type": {
        "type": ["string", "null"],
        "enum": [
          "detached",
          "semi-detached",
          "terraced",
          "apartment"
        ]
      },
      "+building-volume": {
        "type": ["number", "null"]
      },
      "+building-year-construction": {
        "type": ["integer", "null"]
      },
      "+colours": {
        "type": "object",
        "properties": {
          "social": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "water": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "green": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "energy": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "densification": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "utilities": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "mobility": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "social",
          "water",
          "green",
          "energy",
          "densification",
          "utilities",
          "mobility"
        ],
        "additionalProperties": false
      },
      "+roof-total-area": {
        "type": ["number", "null"]
      },
      "+roof-compactness": {
        "type": ["number", "null"]
      },
      "+roof-elevation": {
        "type": ["number", "null"]
      },
      "+roof-irradiance": {
        "type": ["number", "null"]
      },
      "+roof-sun-hours": {
        "type": ["number", "null"]
      },
      "+roof-view-quality": {
        "type": ["number", "null"]
      },
      "+ground-elevation": {
        "type": ["number", "null"]
      }
    }
  },
  "extraRootProperties": {},
  "extraSemanticSurfaces": {},
  "extraCityObjects": {}
}
